# ============================================================
# Данные, создаваемые при работе программы
# ============================================================
# Результаты нарезки и распознавания — только локально.
# Здесь оказываются изображения обрабатываемых документов.
output/
temp/
logs/

# ============================================================
# Материалы для обучения
# ============================================================
# Скриншоты и разметка: это могут быть чужие документы,
# поэтому в репозиторий они не попадают.
learning_materials/
Новая папка/

# ============================================================
# Веса моделей
# ============================================================
# Готовая модель скачивается с Hugging Face:
#   https://huggingface.co/Lord123123/document-page-detector
# Чекпоинты обучения остаются только на машине.
models/*.pth
models/*.pt
*.ckpt

# ============================================================
# Окружение и служебные файлы
# ============================================================
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ============================================================
# Документы для проверки
# ============================================================
# test_document.docx и test_document.png лежат в репозитории:
# содержимое синтетическое, картинки нарисованы кодом.
# Сторонние PDF и чужие скриншоты — только локально.
*.pdf
FireShot*.png

# ============================================================
# IDE и система
# ============================================================
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
